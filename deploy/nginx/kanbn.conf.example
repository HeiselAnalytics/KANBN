server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name kanbn.hsla.cloud;

    # Configure ssl_certificate and ssl_certificate_key in the surrounding
    # Nginx installation or include its shared TLS configuration here.

    location / {
        proxy_pass http://kanbn-app:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
